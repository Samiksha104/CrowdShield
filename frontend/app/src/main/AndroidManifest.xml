<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Required to reach your teammate's FastAPI backend -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Required on Android 13+ (API 33) to show system notifications,
         e.g. NotificationHelper's critical alert notifications. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="true"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.CrowdShield">

        <!-- Splash Screen -->
        <activity
            android:name=".activities.SplashActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Login -->
        <activity
            android:name=".activities.LoginActivity"
            android:exported="false" />

        <!-- Change Password -->
        <activity
            android:name=".activities.ChangePasswordActivity"
            android:exported="false" />

        <!-- Dashboard -->
        <activity
            android:name=".activities.MainActivity"
            android:exported="false" />

        <!-- Live Monitoring -->
        <activity
            android:name=".activities.LiveMonitoringActivity"
            android:exported="false" />

        <!-- Camera Detail -->
        <activity
            android:name=".activities.CameraDetailActivity"
            android:exported="false" />

        <!-- Crowd Heatmap -->
        <activity
            android:name=".activities.HeatmapActivity"
            android:exported="false" />

        <!-- Risk Prediction -->
        <activity
            android:name=".activities.RiskPredictionActivity"
            android:exported="false" />

        <activity android:name=".activities.AlertsActivity" android:exported="false" />
        <activity android:name=".activities.ProfileActivity" android:exported="false" />
        <activity android:name=".activities.SettingsActivity" android:exported="false" />
        <activity android:name=".activities.CameraFeedActivity" android:exported="false" />
        <activity android:name=".activities.EvacuationActivity" android:exported="false" />
        <activity android:name=".activities.ReportsActivity" android:exported="false" />
        <activity android:name=".activities.NotificationsActivity" android:exported="false" />

        <!-- Officer Registry (Admin only — reached solely via the hamburger menu) -->
        <activity android:name=".activities.OfficerRegistryActivity" android:exported="false" />

    </application>

</manifest>